        },
        {
          "class_name": "RequestReviewersComponent",
          "file_name": "RequestReviewers.cs",
          "type": "component",
          "role": "write",
          "endpoint_id": "request_reviewers",
          "name": "Request Reviewers",
          "nickname": "ReqReview",
          "inputs": [
            { "name": "Token", "nickname": "T", "type": "string", "access": "item" },
            { "name": "Space ID", "nickname": "SID", "type": "string", "access": "item" },
            { "name": "Change Request ID", "nickname": "CRID", "type": "string", "access": "item" },
            { "name": "Reviewer User ID", "nickname": "UID", "type": "string", "access": "list" }
          ],
          "outputs": [
            { "name": "Status", "nickname": "S", "type": "string", "access": "item" },
            { "name": "Response", "nickname": "R", "type": "string", "access": "item" }
          ]
        },
        {
          "class_name": "MergeChangeRequestComponent",
          "file_name": "MergeChangeRequest.cs",
          "type": "component",
          "role": "write",
          "endpoint_id": "merge_change_request",
          "name": "Merge Change Request",
          "nickname": "Merge",
          "description": "Publishes the Change Request into the space's live content. This is the only way content actually goes live -- irreversible via the API.",
          "inputs": [
            { "name": "Token", "nickname": "T", "type": "string", "access": "item" },
            { "name": "Space ID", "nickname": "SID", "type": "string", "access": "item" },
            { "name": "Change Request ID", "nickname": "CRID", "type": "string", "access": "item" }
          ],
          "outputs": [
