    {
      "name": "Change Requests",
      "type": "http",
      "description": "The mandatory write path (workflow 4). apply_change_request_content is the single batch write endpoint that every Pages/Rich Content/Compose builder ultimately feeds. Requires a Personal Access Token -- see Connect to GitBook. Merge Change Request additionally requires the token's user to hold change-request:merge permission on the space; kept in the spec even though not currently needed.",
      "components": [
        {
          "class_name": "CreateChangeRequestComponent",
          "file_name": "CreateChangeRequest.cs",
          "type": "component",
          "role": "write",
          "endpoint_id": "create_change_request",
          "name": "Create Change Request",
          "nickname": "NewCR",
          "description": "Response includes a urls.app field -- a direct link to view/edit the Change Request in the GitBook web app. Confirmed via a live API test.",
          "inputs": [
            { "name": "Token", "nickname": "T", "type": "string", "access": "item" },
            { "name": "Space ID", "nickname": "SID", "type": "string", "access": "item" },
            { "name": "Subject", "nickname": "Su", "type": "string", "access": "item", "default": "", "optional": true },
            { "name": "Description", "nickname": "D", "type": "string", "access": "item", "default": "", "optional": true }
          ],
          "outputs": [
            { "name": "Change Request ID", "nickname": "CRID", "type": "string", "access": "item" },
            { "name": "URL", "nickname": "URL", "type": "string", "access": "item" },
            { "name": "Status", "nickname": "S", "type": "string", "access": "item" },
            { "name": "Response", "nickname": "R", "type": "string", "access": "item" }
          ]
        },
        {
          "class_name": "GetAllChangeRequestsComponent",
          "file_name": "GetAllChangeRequests.cs",
          "type": "component",
          "role": "write",
          "endpoint_id": "list_change_requests",
          "name": "List Change Requests",
          "nickname": "AllCRs",
          "inputs": [
            { "name": "Token", "nickname": "T", "type": "string", "access": "item" },
            { "name": "Space ID", "nickname": "SID", "type": "string", "access": "item" }
          ],
          "outputs": [
            { "name": "Status", "nickname": "S", "type": "string", "access": "item" },
            { "name": "Response", "nickname": "R", "type": "string", "access": "item" }
          ]
        },
        {
          "class_name": "GetChangeRequestComponent",
          "file_name": "GetChangeRequest.cs",
          "type": "component",
          "role": "write",
          "endpoint_id": "get_change_request",
          "name": "Get Change Request",
          "nickname": "CR",
          "inputs": [
            { "name": "Token", "nickname": "T", "type": "string", "access": "item" },
            { "name": "Space ID", "nickname": "SID", "type": "string", "access": "item" },
            { "name": "Change Request ID", "nickname": "CRID", "type": "string", "access": "item" }
          ],
          "outputs": [
            { "name": "URL", "nickname": "URL", "type": "string", "access": "item" },
            { "name": "Status", "nickname": "S", "type": "string", "access": "item" },
            { "name": "Response", "nickname": "R", "type": "string", "access": "item" }
          ]
        },
        {
          "class_name": "UpdateChangeRequestComponent",
          "file_name": "UpdateChangeRequest.cs",
          "type": "component",
          "role": "write",
          "endpoint_id": "update_change_request",
          "name": "Update Change Request",
          "nickname": "UpdCR",
          "inputs": [
            { "name": "Token", "nickname": "T", "type": "string", "access": "item" },
            { "name": "Space ID", "nickname": "SID", "type": "string", "access": "item" },
            { "name": "Change Request ID", "nickname": "CRID", "type": "string", "access": "item" },
            { "name": "Subject", "nickname": "Su", "type": "string", "access": "item", "default": "", "optional": true },
            { "name": "Description", "nickname": "D", "type": "string", "access": "item", "default": "", "optional": true }
          ],
          "outputs": [
            { "name": "Status", "nickname": "S", "type": "string", "access": "item" },
            { "name": "Response", "nickname": "R", "type": "string", "access": "item" }
          ]
        },
        {
          "class_name": "GetChangeRequestContentComponent",
          "file_name": "GetChangeRequestContent.cs",
          "type": "component",
          "role": "write",
          "endpoint_id": "get_change_request_content",
          "name": "Get Change Request Content",
          "nickname": "CRContent",
          "inputs": [
            { "name": "Token", "nickname": "T", "type": "string", "access": "item" },
            { "name": "Space ID", "nickname": "SID", "type": "string", "access": "item" },
            { "name": "Change Request ID", "nickname": "CRID", "type": "string", "access": "item" }
          ],
          "outputs": [
            { "name": "Status", "nickname": "S", "type": "string", "access": "item" },
            { "name": "Response", "nickname": "R", "type": "string", "access": "item" }
          ]
        },
        {
