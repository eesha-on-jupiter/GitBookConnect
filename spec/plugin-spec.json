    {
      "name": "Pages",
      "type": "json",
      "description": "Content-type division (batch-write API detected -- see pr-spec). Build Page (JSON) (Rich Content tab) is the primary authoring path; Build Page (Markdown) here is a lightweight secondary path for quick plain-text pages. Satisfies workflows 1, 2, 3, 5.",
      "components": [
        {
          "class_name": "BuildPageMarkdownComponent",
          "file_name": "BuildPageMarkdown.cs",
          "type": "component",
          "role": "unit",
          "name": "Build Page (Markdown)",
          "nickname": "MDPage",
          "description": "Secondary/lightweight path -- prefer Build Page (JSON) in Rich Content for styled text, blocks, and tables.",
          "inputs": [
            { "name": "Title", "nickname": "Ti", "type": "string", "access": "item", "default": "", "optional": true },
            { "name": "Markdown Body", "nickname": "MB", "type": "string", "access": "item" },
            { "name": "Icon", "nickname": "I", "type": "string", "access": "item", "default": "", "optional": true }
          ],
          "outputs": [
            { "name": "Document JSON", "nickname": "DJ", "type": "string", "access": "item" }
          ]
        },
        {
          "class_name": "MarkdownTableFromGridComponent",
          "file_name": "MarkdownTableFromGrid.cs",
          "type": "component",
          "role": "unit",
          "name": "Markdown Table From Grid",
          "nickname": "GridToMD",
          "description": "Secondary path for the tabular benchmark (workflow 2) -- prefer Table Block (Rich Content) for JSON. Rows x columns tree -> a Markdown table string, for Build Page (Markdown)'s Markdown Body.",
          "inputs": [
            { "name": "Header Row", "nickname": "H", "type": "string", "access": "list", "default": "", "optional": true },
            { "name": "Grid", "nickname": "G", "type": "string", "access": "tree" }
          ],
          "outputs": [
            { "name": "Markdown Body", "nickname": "MB", "type": "string", "access": "item" }
          ]
        },
        {
          "class_name": "InsertPageComponent",
          "file_name": "InsertPage.cs",
          "type": "component",
          "role": "unit",
          "name": "Insert Page",
          "nickname": "InsPage",
          "description": "Satisfies workflow 1 (one call, list-access -- batch-create many pages by wiring lists).",
          "inputs": [
            { "name": "Document JSON", "nickname": "DJ", "type": "string", "access": "list" },
            { "name": "Into", "nickname": "Into", "type": "string", "access": "list", "default": "", "optional": true },
            { "name": "At", "nickname": "At", "type": "int", "access": "list", "default": "", "optional": true },
            { "name": "Ref", "nickname": "Ref", "type": "string", "access": "list", "default": "", "optional": true }
          ],
          "outputs": [
            { "name": "Change JSON", "nickname": "CJ", "type": "string", "access": "list" }
          ]
        },
        {
          "class_name": "UpdatePageComponent",
          "file_name": "UpdatePage.cs",
          "type": "component",
          "role": "unit",
          "name": "Update Page",
          "nickname": "UpdPage",
          "inputs": [
            { "name": "Page ID", "nickname": "PID", "type": "string", "access": "list" },
            { "name": "Document JSON", "nickname": "DJ", "type": "string", "access": "list", "default": "", "optional": true },
            { "name": "Into", "nickname": "Into", "type": "string", "access": "list", "default": "", "optional": true },
            { "name": "At", "nickname": "At", "type": "int", "access": "list", "default": "", "optional": true }
          ],
          "outputs": [
            { "name": "Change JSON", "nickname": "CJ", "type": "string", "access": "list" }
          ]
        },
        {
          "class_name": "BuildPagesFromTreeComponent",
          "file_name": "BuildPagesFromTree.cs",
          "type": "component",
          "role": "unit",
          "name": "Build Pages From Tree",
          "nickname": "TreePages",
          "description": "Dual Style Pattern parametric variant. Satisfies workflow 3 -- one shared parent target (item) plus every page property as an independent, optional tree-access input, joined positionally per branch. Emits insert_page when no Page ID is given for a branch, update_page when one is.",
          "inputs": [
            { "name": "Into", "nickname": "Into", "type": "string", "access": "item", "default": "", "optional": true },
            { "name": "Page ID", "nickname": "PID", "type": "string", "access": "tree", "default": "", "optional": true },
            { "name": "Title", "nickname": "Ti", "type": "string", "access": "tree", "default": "", "optional": true },
            { "name": "Body Text", "nickname": "BT", "type": "string", "access": "tree", "default": "", "optional": true },
            { "name": "Icon", "nickname": "I", "type": "string", "access": "tree", "default": "", "optional": true }
          ],
          "outputs": [
            { "name": "Change JSON", "nickname": "CJ", "type": "string", "access": "list" }
          ]
        }
      ]
    },
    {
      "name": "Text",
      "type": "json",
      "description": "Inline text runs and marks (GitBook's DocumentTextMark union -- confirmed set: bold, italic, strikethrough, code, keyboard, superscript, subscript, color. No underline mark exists in the API.) Chainable recursive components -- wire a mark's Text JSON output into another mark's Text JSON input to combine styles on one run (e.g. Bold -> Italic -> Color).",
      "components": [
        {
          "class_name": "PlainTextComponent",
          "file_name": "PlainText.cs",
          "type": "component",
          "role": "unit",
          "name": "Plain Text",
          "nickname": "Text",
          "description": "Starting point for a styled run -- wraps a raw string into a Text JSON leaf with no marks. Chain Mark components after it, or use it unstyled.",
          "inputs": [
            { "name": "Text", "nickname": "Tx", "type": "string", "access": "item" }
          ],
          "outputs": [
            { "name": "Text JSON", "nickname": "TJ", "type": "string", "access": "item" }
          ]
        },
        {
          "class_name": "BoldMarkComponent",
          "file_name": "BoldMark.cs",
          "type": "component",
          "role": "recursive",
          "name": "Bold Mark",
          "nickname": "Bold",
          "inputs": [
            { "name": "Text JSON", "nickname": "TJ", "type": "string", "access": "item" }
          ],
          "outputs": [
            { "name": "Text JSON", "nickname": "TJ", "type": "string", "access": "item" }
          ]
