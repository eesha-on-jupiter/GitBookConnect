{
  "plugin_name": "GitBookConnect",
  "platform": "GitBook",
  "base_url": "https://api.gitbook.com/v1",
  "auth_method": "Bearer token",
  "api_version": "v1 (OpenAPI 0.0.1-beta)",
  "tab_name": "GitBookConnect",
  "aec_features": {
    "selected": [],
    "already_delivered_by_spec": ["In-GH Documentation Writer (Text + Rich Content tabs)", "Auth Manager (Connect to GitBook)", "Error Reporter (Status/Response on every HTTP component)", "Batch Processor (Content Changes Aggregator)"],
    "not_a_fit": ["BIM Data Bridge (no metadata-dictionary field in the API)", "Geometry Serializer (no coordinate/geometry field in the API)"],
    "declined": [{ "feature": "Version Watcher (Get Revision / Get Revision Changes)", "reason": "No workflow currently calls for a pre-sync conflict check; user declined at Gate 3. Add via rest-add-feature if a real overwrite conflict comes up." }]
  },
  "subcategories": [
    {
      "name": "Auth",
      "type": "http",
      "components": [
        {
          "class_name": "GitBookAuthComponent",
          "file_name": "GitBookAuth.cs",
          "type": "component",
          "role": "write",
          "endpoint_id": "get_current_user",
          "name": "Connect to GitBook",
          "nickname": "Connect",
          "description": "Use a GitBook Personal Access Token (Settings -> Developer -> Personal Access Tokens), not an integration token -- Change Request writes (Change Requests tab) explicitly reject integration tokens per the API's per-endpoint security requirements. A personal token also inherits the user's actual space role (Admin/Editor/Reviewer/Viewer); Reviewer/Viewer roles will still be blocked from creating Change Requests.",
          "inputs": [
            { "name": "Token", "nickname": "T", "type": "string", "access": "item", "default": "" }
          ],
          "outputs": [
            { "name": "Status", "nickname": "S", "type": "string", "access": "item" },
            { "name": "Response", "nickname": "R", "type": "string", "access": "item" }
          ]
        }
      ]
    },
    {
